# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123
# Freeze the demo clock so the bundled certificates show covered / expiring / expired.
# Leave blank in production.
DEMO_TODAY=2026-11-25
# Signs the local session cookie. Required before any public deploy.
AUTH_SECRET=
# IANA timezone used when DEMO_TODAY is unset.
APP_TIMEZONE=America/Chicago
# Set to 1 to ignore any keys below and stay on mocks.
FORCE_MOCKS=

# Supabase. When all three are set, auth, Postgres, and storage replace the local file store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST MODE ONLY. Live keys (sk_live_, rk_live_, pk_live_) are refused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_AUDIT_RESCUE=

# Resend. When unset, mail is printed to the server log and stored in the outbox.
RESEND_API_KEY=
EMAIL_FROM=AuditReady <certificates@auditready.local>

# OpenAI-compatible vision endpoint. Example: https://api.openai.com/v1
# When unset, PDFs are parsed from their text and bundled sample filenames use a fixed reading.
EXTRACTION_API_URL=
EXTRACTION_API_KEY=
EXTRACTION_MODEL=gpt-4o

# Bearer token for Vercel Cron. Required in production. Open in local dev when unset.
CRON_SECRET=
